# 이 파일을 .env 로 복사한 뒤 값을 채우세요. (.env 는 git에 올라가지 않습니다)
# EXPO_PUBLIC_ 로 시작하는 값은 앱 번들에 포함됩니다. 비밀키를 넣지 마세요.

# Supabase 대시보드 → Project Settings → API
EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# https://openweathermap.org
EXPO_PUBLIC_WEATHER_API_KEY=
# https://www.data.go.kr (조위 API)
EXPO_PUBLIC_TIDE_API_KEY=

# 네이버 클라우드 → Maps → Application의 Client ID (빌드할 때 앱에 들어감)
EXPO_PUBLIC_NAVER_MAP_CLIENT_ID=

# Sentry → Project Settings → Client Keys (DSN). 비워두면 에러 추적을 끕니다.
EXPO_PUBLIC_SENTRY_DSN=
# 소스맵 업로드용 (선택). EAS 빌드에서만 필요
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Groq 키는 여기가 아니라 Supabase secret 으로 설정합니다:
#   npx supabase secrets set GROQ_API_KEY=...
