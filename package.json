    "jest": "~29.7.0",
    "jest-expo": "~57.0.5",
    "nativewind": "^4.2.7",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.89.0",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
