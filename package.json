    "@shopify/flash-list": "2.0.2",
    "@supabase/supabase-js": "^2.117.2",
    "@tanstack/react-query": "^5.104.0",
    "@types/jest": "29.5.14",
    "babel-preset-expo": "~57.0.0",
    "date-fns": "^4.4.0",
    "expo": "^57.0.25",
